{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/**,public/**}"
    },
    "api/[...path].js": {
      "includeFiles": "{server/**,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/reports/(.*)", "destination": "/report-detail" },
    { "source": "/transparency", "destination": "/transparency" },
    { "source": "/city-impact-transparency", "destination": "/transparency" },
    { "source": "/maintenance", "destination": "/maintenance" },
    { "source": "/maintenance-calendar", "destination": "/maintenance" },
    { "source": "/knowledge", "destination": "/knowledge" },
    { "source": "/knowledge-center", "destination": "/knowledge" },
    { "source": "/digital-twin", "destination": "/digital-twin" },
    { "source": "/radar", "destination": "/radar" },
    { "source": "/problem-radar", "destination": "/radar" },
    { "source": "/report", "destination": "/report" },
    { "source": "/login", "destination": "/login" },
    { "source": "/dashboard", "destination": "/dashboard" },
    { "source": "/citizen-dashboard", "destination": "/dashboard" },
    { "source": "/admin", "destination": "/admin" },
    { "source": "/admin-dashboard", "destination": "/admin" },
    { "source": "/staff", "destination": "/staff" },
    { "source": "/staff-dashboard", "destination": "/staff" }
  ]
}