# Civic Resolve AI — Environment Configuration Example
# Copy this file to .env and provide your project values. Never commit secrets.

# Server Configuration
PORT=3050
NODE_ENV=development
SESSION_SECRET=civic_resolve_secure_session_secret_for_prototype_eval_only_2026

# Supabase Project Configuration (Optional for local SQLite demo; required for Supabase deployment)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Map Configuration (Leaflet OpenStreetMap defaults used if unset)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Demo Maintenance and Cron Endpoint Authorization
DEMO_CRON_SECRET=civic_resolve_cron_secret_guard_token_2026

# Geographic Municipality Boundary (Hyderabad / Telangana default bounding box for prototype)
MUNICIPALITY_NAME=Greater Hyderabad Municipal Corporation (Demo Area)
BOUNDS_MIN_LAT=17.2000
BOUNDS_MAX_LAT=17.6000
BOUNDS_MIN_LNG=78.2000
BOUNDS_MAX_LNG=78.7000
