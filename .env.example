# Civic Resolve AI — Environment Configuration Example
# Copy this file to .env and provide your project values. Never commit secrets.

# Server Configuration
PORT=3050
NODE_ENV=development
SESSION_SECRET=civic_resolve_secure_session_secret_for_prototype_eval_only_2026

# Production Database Configuration (PostgreSQL / Supabase)
# MANDATORY in production (NODE_ENV=production) on Vercel or cloud deployments.
# For Supabase, use the Transaction Pooler or Direct Connection URI from Project Settings -> Database.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Alternative connection URI variable recognized automatically:
# POSTGRES_URL=postgresql://...

# Supabase REST / Storage Configuration (MANDATORY in production for durable photo evidence)
# In Supabase dashboard: Storage -> New Bucket -> Name: 'civic-photos' (Private bucket).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=civic-photos

# Allowed CORS Origins (Comma-separated list; defaults to local origins if omitted)
# Example: https://civic-resolve.vercel.app,http://localhost:3050
ALLOWED_ORIGINS=http://localhost:3050,http://127.0.0.1:3050

# Map Configuration (Leaflet OpenStreetMap defaults used if unset)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Demo Maintenance and Cron Endpoint Authorization
DEMO_CRON_SECRET=civic_resolve_cron_secret_guard_token_2026

# Geographic Municipality Boundary (Hyderabad / Telangana default bounding box for prototype)
MUNICIPALITY_NAME=Greater Hyderabad Municipal Corporation (Demo Area)
BOUNDS_MIN_LAT=17.2000
BOUNDS_MAX_LAT=17.6000
BOUNDS_MIN_LNG=78.2000
BOUNDS_MAX_LNG=78.7000
